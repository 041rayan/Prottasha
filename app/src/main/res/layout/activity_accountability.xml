<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <!-- Header -->
        <TextView
            style="@style/TextAppearance.Prottasha.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/accountability_title" />

        <TextView
            style="@style/TextAppearance.Prottasha.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxsmall"
            android:text="Designate a trusted personal ally and share your honest daily recovery commitments."
            android:textColor="@color/color_text_secondary" />

        <!-- Current Partner Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/accountability_current_partner_card"
            style="@style/Widget.Prottasha.Surface.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:id="@+id/accountability_partner_header"
                    style="@style/TextAppearance.Prottasha.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active Partner"
                    android:textColor="@color/color_hope" />

                <TextView
                    android:id="@+id/accountability_partner_details"
                    style="@style/TextAppearance.Prottasha.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxsmall"
                    tools:text="Rahim (+8801712345678)" />

                <TextView
                    android:id="@+id/accountability_partner_status"
                    style="@style/TextAppearance.Prottasha.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/color_text_muted"
                    tools:text="Connected on 2026-11-10" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/accountability_revoke"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:fontFamily="@font/ibm_plex_sans_medium"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="Revoke Partner"
                    android:textColor="@color/color_crisis"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Partner Setup Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Prottasha.Surface.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    style="@style/TextAppearance.Prottasha.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Set or Update Partner" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Prottasha.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:hint="Partner name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/accountability_name_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:textColor="@color/color_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Prottasha.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:hint="Phone number">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/accountability_phone_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:textColor="@color/color_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/accountability_pick"
                        style="@style/Widget.Prottasha.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/spacing_small"
                        android:minHeight="@dimen/touch_target_min"
                        android:text="@string/accountability_pick" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/accountability_save_button"
                        style="@style/Widget.Prottasha.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="@dimen/touch_target_min"
                        android:text="Save Partner" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Share Preview Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Prottasha.Surface.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    style="@style/TextAppearance.Prottasha.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Exact Share Preview" />

                <TextView
                    style="@style/TextAppearance.Prottasha.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxsmall"
                    android:text="This is the exact note that will be sent. You can edit it before sharing."
                    android:textColor="@color/color_text_secondary" />

                <EditText
                    android:id="@+id/accountability_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:background="@drawable/shape_card_surface"
                    android:hint="@string/accountability_hint"
                    android:inputType="textCapSentences|textMultiLine"
                    android:padding="@dimen/spacing_medium"
                    android:fontFamily="@font/ibm_plex_sans_regular"
                    android:textColor="@color/color_text_primary"
                    android:textColorHint="@color/color_text_muted"
                    android:textSize="14sp"
                    android:minLines="4"
                    android:gravity="top|start" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/accountability_share"
                    style="@style/Widget.Prottasha.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/accountability_share" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Privacy & Visibility Disclosure Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Prottasha.Surface.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:layout_marginBottom="@dimen/spacing_large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    style="@style/TextAppearance.Prottasha.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="What Circle and Partner Can See" />

                <TextView
                    style="@style/TextAppearance.Prottasha.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xsmall"
                    android:text="• Circle Pod Members: See only your pseudonym, chat messages, and live online presence in the closed pod.\n\n• Accountability Partner: Sees ONLY the notes and messages you explicitly share with them. They have no access to your app.\n\n• Strictly Private: Your journal reflections, private photos, usage statistics, and passwords remain encrypted on this device."
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
