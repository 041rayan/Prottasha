<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <!-- Title -->
        <TextView
            style="@style/TextAppearance.Prottasha.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="App Privacy Lock" />

        <TextView
            style="@style/TextAppearance.Prottasha.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxsmall"
            android:text="Protect your recovery logs, reflections, and habits with biometric authentication or a custom PIN."
            android:textColor="@color/color_text_secondary" />

        <!-- Master Lock Toggle Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Prottasha.Surface.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Prottasha.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enable App Lock" />

                    <TextView
                        style="@style/TextAppearance.Prottasha.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxsmall"
                        android:text="Require PIN or fingerprint to open Prottasha"
                        android:textColor="@color/color_text_secondary" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/app_lock_enable_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- PIN Settings Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/app_lock_pin_card"
            style="@style/Widget.Prottasha.Surface.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:id="@+id/app_lock_pin_title"
                    style="@style/TextAppearance.Prottasha.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Security PIN" />

                <TextView
                    android:id="@+id/app_lock_pin_status"
                    style="@style/TextAppearance.Prottasha.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxsmall"
                    android:text="PIN is configured"
                    android:textColor="@color/color_text_muted" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/app_lock_new_pin_layout"
                    style="@style/Widget.Prottasha.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:hint="New 4-digit PIN">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/app_lock_new_pin_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ibm_plex_mono_medium"
                        android:inputType="numberPassword"
                        android:maxLength="6"
                        android:textColor="@color/color_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/app_lock_confirm_pin_layout"
                    style="@style/Widget.Prottasha.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:hint="Confirm PIN">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/app_lock_confirm_pin_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ibm_plex_mono_medium"
                        android:inputType="numberPassword"
                        android:maxLength="6"
                        android:textColor="@color/color_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/app_lock_save_pin_button"
                    style="@style/Widget.Prottasha.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="Update PIN" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Biometric Toggle Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/app_lock_biometric_card"
            style="@style/Widget.Prottasha.Surface.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Prottasha.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Biometric Unlock" />

                    <TextView
                        style="@style/TextAppearance.Prottasha.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxsmall"
                        android:text="Use fingerprint or face recognition"
                        android:textColor="@color/color_text_secondary" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/app_lock_biometric_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Lock Timeout Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/app_lock_timeout_card"
            style="@style/Widget.Prottasha.Surface.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:layout_marginBottom="@dimen/spacing_large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    style="@style/TextAppearance.Prottasha.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lock Timeout" />

                <TextView
                    style="@style/TextAppearance.Prottasha.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxsmall"
                    android:text="Lock automatically when leaving app"
                    android:textColor="@color/color_text_secondary" />

                <RadioGroup
                    android:id="@+id/app_lock_timeout_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small">

                    <RadioButton
                        android:id="@+id/radio_timeout_immediate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ibm_plex_sans_medium"
                        android:text="Immediately"
                        android:textColor="@color/color_text_primary" />

                    <RadioButton
                        android:id="@+id/radio_timeout_30s"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ibm_plex_sans_medium"
                        android:text="After 30 seconds"
                        android:textColor="@color/color_text_primary" />

                    <RadioButton
                        android:id="@+id/radio_timeout_1m"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ibm_plex_sans_medium"
                        android:text="After 1 minute"
                        android:textColor="@color/color_text_primary" />

                    <RadioButton
                        android:id="@+id/radio_timeout_5m"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ibm_plex_sans_medium"
                        android:text="After 5 minutes"
                        android:textColor="@color/color_text_primary" />
                </RadioGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
