<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crisis Lifeline &amp; Directory"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_headline"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxsmall"
            android:text="Immediate non-judgmental human support. Free and confidential (EX-13)."
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/text_body" />

        <!-- Emergency 999 One-Tap Dial Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Prottasha.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            app:strokeColor="@color/color_crisis_coral">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IMMEDIATE EMERGENCY (24/7)"
                    android:textColor="@color/color_crisis_coral"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxsmall"
                    android:text="Bangladesh National Emergency 999"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDial999"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:backgroundTint="@color/color_crisis_coral"
                    android:text="Dial 999 (Implicit Intent)"
                    android:textColor="@color/color_text_primary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Talk Hope 24/7 Mental Health Line -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Prottasha.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Talk Hope Bangladesh (24/7 Free &amp; Confidential)"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxsmall"
                    android:text="Phone: +880 9638 881 888 • Counselors &amp; Volunteers"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDialTalkHope"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="Dial Talk Hope (+880 9638 881 888)" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Kaan Pete Roi Emotional Support -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Prottasha.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kaan Pete Roi Emotional Support"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxsmall"
                    android:text="Phone: 09612-119911 • Emotional Support Helpline"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDialKaanPeteRoi"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="Dial Kaan Pete Roi (09612-119911)" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Share Habit Contract Action (Implicit Intent Share) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareHabitContract"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="Share Habit Contract with Observer (ACTION_SEND)"
            android:textColor="@color/color_identity_glow" />

        <!-- Open External Clinical Resource (Implicit Intent Link) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenClinicalLink"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:text="Open FindAHelpline Directory Online (ACTION_VIEW)"
            android:textColor="@color/color_text_secondary" />

        <!-- Verified Clinics List (HTTP Remote API JSON Parsing) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="Verified Psychological Support Centers"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDirectorySource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxsmall"
            android:text="Loaded via remote HTTP JSON parser"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/text_caption" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTherapistDirectory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginTop="@dimen/spacing_small" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
