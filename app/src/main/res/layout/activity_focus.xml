<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large">

        <TextView
            style="@style/TextAppearance.Prottasha.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/focus_title" />

        <TextView
            android:id="@+id/focus_status_label"
            style="@style/TextAppearance.Prottasha.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxsmall"
            android:gravity="center"
            android:text="@string/focus_status_ready"
            android:textColor="@color/color_text_secondary" />

        <!-- Big Countdown Timer Display -->
        <TextView
            android:id="@+id/focus_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xlarge"
            android:layout_marginBottom="@dimen/spacing_xlarge"
            android:fontFamily="@font/ibm_plex_mono_medium"
            android:text="25:00"
            android:textColor="@color/color_hope"
            android:textSize="56sp" />

        <!-- Minutes Input & Presets Container -->
        <LinearLayout
            android:id="@+id/focus_input_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Prottasha.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/focus_minutes_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/focus_minutes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ibm_plex_mono_medium"
                    android:inputType="number"
                    android:text="@string/focus_default_minutes" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Completion Summary Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/focus_summary_card"
            style="@style/Widget.Prottasha.Surface.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:visibility="gone"
            app:strokeColor="@color/color_hope"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large">

                <TextView
                    style="@style/TextAppearance.Prottasha.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Session Complete! 🎉"
                    android:textColor="@color/color_hope" />

                <TextView
                    android:id="@+id/focus_summary_text"
                    style="@style/TextAppearance.Prottasha.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:gravity="center"
                    android:text="@string/focus_status_completed" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Control Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/focus_start"
            style="@style/Widget.Prottasha.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/focus_start" />

        <LinearLayout
            android:id="@+id/focus_active_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/focus_pause"
                style="@style/Widget.Prottasha.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/focus_pause" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/focus_resume"
                style="@style/Widget.Prottasha.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/focus_resume"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/focus_end"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:fontFamily="@font/ibm_plex_sans_medium"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/focus_end"
                android:textColor="@color/color_crisis" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
