<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/spacing_large">
        <TextView android:id="@+id/guard_rule_target" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/color_text_primary" android:textSize="@dimen/text_headline" android:textStyle="bold" />
        <RadioGroup android:id="@+id/guard_mode_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_medium" android:checkedButton="@id/guard_mode_pause">
            <RadioButton android:id="@+id/guard_mode_pause" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/guard_mode_pause" />
            <RadioButton android:id="@+id/guard_mode_budget" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/guard_mode_budget" />
            <RadioButton android:id="@+id/guard_mode_block" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/guard_mode_block" />
        </RadioGroup>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/guard_budget_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/guard_budget_hint" android:visibility="gone">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/guard_budget_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:text="@string/guard_budget_default" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/guard_rule_save" style="@style/Widget.Prottasha.Button.Pill" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_large" android:text="@string/guard_save" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
