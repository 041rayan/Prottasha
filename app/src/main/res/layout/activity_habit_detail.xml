<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Habit Architecture (4 Laws)"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_headline"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHabitIdLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxsmall"
            android:text="Habit ID: #"
            android:textColor="@color/color_identity_glow"
            android:textSize="@dimen/text_caption" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:hint="Title"
            app:boxStrokeColor="@color/color_identity_glow">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/color_text_primary" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:hint="Law 1 Cue (Make it Obvious / Invisible)"
            app:boxStrokeColor="@color/color_identity_glow">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDetailCue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/color_text_primary" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:hint="Law 2 Craving (Surface urge vs Underlying motive)"
            app:boxStrokeColor="@color/color_identity_glow">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDetailCraving"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/color_text_primary" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:hint="Law 3 Response (Two-minute version - AH-14)"
            app:boxStrokeColor="@color/color_identity_glow">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDetailResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/color_text_primary" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:hint="Law 4 Reward (Immediate vote reinforcement)"
            app:boxStrokeColor="@color/color_identity_glow">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDetailReward"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/color_text_primary" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchDetailGoodHabit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="Good habit to build (checked) / Bad habit to break (unchecked)"
            android:textColor="@color/color_text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_large">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveHabit"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/color_identity_glow"
                android:text="Save Changes" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteHabit"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:text="Delete"
                android:textColor="@color/color_crisis_coral" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
