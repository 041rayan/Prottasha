<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large">

        <!-- Title & Subtitle -->
        <TextView
            android:id="@+id/habit_history_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_headline"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/habit_history_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/text_body" />

        <!-- Mindful Planning Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/habit_mindful_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            app:cardBackgroundColor="@color/color_surface"
            app:strokeColor="@color/color_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:id="@+id/habit_detail_cue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_body"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/habit_detail_if_then"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xsmall"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_body"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/habit_detail_rebound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xsmall"
                    android:textColor="@color/color_friction"
                    android:textSize="@dimen/text_body"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Truthful Statistics Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/habit_stats_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            app:cardBackgroundColor="@color/color_surface"
            app:strokeColor="@color/color_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Truthful Statistics"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:columnCount="2">

                    <TextView
                        android:id="@+id/habit_stats_current_streak"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:id="@+id/habit_stats_best_streak"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:id="@+id/habit_stats_rate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginTop="@dimen/spacing_xsmall"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:id="@+id/habit_stats_total"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginTop="@dimen/spacing_xsmall"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="@dimen/text_body" />
                </GridLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Calendar & History Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            app:cardBackgroundColor="@color/color_surface"
            app:strokeColor="@color/color_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Consistency History"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <com.prottasha.habits.ui.HabitCalendarView
                    android:id="@+id/habit_history_calendar"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginTop="@dimen/spacing_small" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/habit_backfill_button"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xsmall"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/habit_backfill" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Substeps Card (for Build) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/habit_detail_substeps_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:visibility="gone"
            app:cardBackgroundColor="@color/color_surface"
            app:strokeColor="@color/color_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/habit_substeps_title"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/habit_detail_substeps_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Vacation / Rest Periods Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/habit_vacation_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            app:cardBackgroundColor="@color/color_surface"
            app:strokeColor="@color/color_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/habit_vacation_title"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/habit_vacations_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/habit_add_vacation_button"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/habit_add_vacation" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Scheduled Reminders Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/habit_reminders_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            app:cardBackgroundColor="@color/color_surface"
            app:strokeColor="@color/color_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/reminder_card_title"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <!-- Notification Permission Warning Banner -->
                <LinearLayout
                    android:id="@+id/habit_reminder_permission_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:background="@color/color_surface_raised"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_small"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/reminder_permission_warning"
                        android:textColor="@color/color_friction"
                        android:textSize="@dimen/text_caption" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/habit_reminder_permission_button"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xsmall"
                        android:minHeight="@dimen/touch_target_min"
                        android:text="@string/reminder_permission_fix" />
                </LinearLayout>

                <TextView
                    android:id="@+id/habit_reminders_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/reminder_empty"
                    android:textColor="@color/color_text_muted"
                    android:textSize="@dimen/text_caption" />

                <LinearLayout
                    android:id="@+id/habit_reminders_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/habit_add_reminder_button"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/reminder_add_button" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Daily Note & Image Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            app:cardBackgroundColor="@color/color_surface"
            app:strokeColor="@color/color_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Daily Reflection &amp; Evidence"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <!-- Attached image preview -->
                <ImageView
                    android:id="@+id/habit_image_preview"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xsmall"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/habit_attach_image_button"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target_min"
                        android:text="Attach Photo" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/habit_remove_image_button"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target_min"
                        android:text="Remove Photo"
                        android:textColor="@color/color_crisis"
                        android:visibility="gone" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:hint="@string/habit_note_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/habit_note_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences|textMultiLine"
                        android:minLines="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/habit_note_save"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/habit_note_save" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Management Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xlarge"
            android:layout_marginBottom="@dimen/spacing_large"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/habit_edit_button"
                style="@style/Widget.Prottasha.Button.Pill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:text="Edit Habit" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/habit_archive_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/habit_archive" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/habit_delete_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/habit_delete"
                android:textColor="@color/color_crisis" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
