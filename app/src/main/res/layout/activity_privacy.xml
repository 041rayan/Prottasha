<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <!-- Title -->
        <TextView
            style="@style/TextAppearance.Prottasha.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy_title" />

        <TextView
            android:id="@+id/privacy_lock_copy"
            style="@style/TextAppearance.Prottasha.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxsmall"
            android:text="@string/privacy_lock_copy"
            android:textColor="@color/color_text_secondary" />

        <!-- App Privacy Lock Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Prottasha.Surface.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    style="@style/TextAppearance.Prottasha.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Screen Privacy Lock" />

                <TextView
                    android:id="@+id/privacy_lock_status_text"
                    style="@style/TextAppearance.Prottasha.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xsmall"
                    android:text="Protect your on-screen journal and habits with PIN or fingerprint."
                    android:textColor="@color/color_text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/privacy_lock_setup_button"
                    style="@style/Widget.Prottasha.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/privacy_lock_setup"
                    android:textColor="@color/color_identity" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Export Encrypted Archive Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Prottasha.Surface.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    style="@style/TextAppearance.Prottasha.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Export Encrypted Backup (.pta)" />

                <TextView
                    style="@style/TextAppearance.Prottasha.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xsmall"
                    android:text="Encrypted using AES-256-GCM and PBKDF2 with 100,000 iterations. Backs up all habits, reflections, guard rules, and recovery memory."
                    android:textColor="@color/color_text_secondary" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/privacy_password_layout"
                    style="@style/Widget.Prottasha.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:hint="@string/privacy_export_password"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/privacy_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:saveEnabled="false"
                        android:textColor="@color/color_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/privacy_export"
                    style="@style/Widget.Prottasha.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/privacy_export" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Import Encrypted Archive Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Prottasha.Surface.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    style="@style/TextAppearance.Prottasha.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Import Encrypted Backup" />

                <TextView
                    style="@style/TextAppearance.Prottasha.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xsmall"
                    android:text="Restores habits, reflections, and rules transactionally with full schema and integrity checks."
                    android:textColor="@color/color_text_secondary" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/privacy_import_password_layout"
                    style="@style/Widget.Prottasha.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:hint="@string/privacy_import_password"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/privacy_import_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:saveEnabled="false"
                        android:textColor="@color/color_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/privacy_import"
                    style="@style/Widget.Prottasha.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/privacy_import"
                    android:textColor="@color/color_hope" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Status & Result Summary -->
        <TextView
            android:id="@+id/privacy_status"
            style="@style/TextAppearance.Prottasha.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/color_text_secondary"
            tools:text="Encrypted export created." />

        <TextView
            android:id="@+id/privacy_summary_details"
            style="@style/TextAppearance.Prottasha.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxsmall"
            android:layout_marginBottom="@dimen/spacing_large"
            android:textColor="@color/color_hope"
            android:visibility="gone"
            tools:text="Restored: 12 habits, 5 reflections, 3 rules"
            tools:visibility="visible" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
