<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/spacing_large"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="@dimen/spacing_large">

        <TextView
            style="@style/TextAppearance.Prottasha.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_title" />

        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_large">

            <ImageView
                android:id="@+id/profile_photo_image"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="center"
                android:background="@drawable/shape_avatar_circle"
                android:clipToOutline="true"
                android:contentDescription="@string/profile_photo_label"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/profile_avatar_initials"
                style="@style/TextAppearance.Prottasha.Headline"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:textColor="@color/color_hope" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/profile_photo_edit_button"
                style="@style/Widget.Prottasha.Button.Icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:contentDescription="@string/profile_choose_photo"
                app:backgroundTint="@color/color_hope"
                app:icon="@drawable/ic_camera"
                app:iconGravity="textStart"
                app:iconTint="@color/color_on_hope" />
        </FrameLayout>

        <TextView
            android:id="@+id/profile_pseudonym_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_small"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/text_label" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_small"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/profile_choose_photo_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/profile_choose_photo"
                android:textColor="@color/color_hope" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/profile_remove_photo_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/profile_remove_photo"
                android:textColor="@color/color_crisis"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/profile_photo_privacy_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/profile_photo_desc"
            android:textColor="@color/color_text_muted"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:id="@+id/profile_private_section_label"
            style="@style/TextAppearance.Prottasha.Metric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/profile_private_section" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/profile_display_name_layout"
            style="@style/Widget.Prottasha.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:hint="@string/profile_display_name_hint">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/profile_display_name_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:maxLength="80"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/profile_circle_section_label"
            style="@style/TextAppearance.Prottasha.Metric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/profile_circle_section" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/profile_pseudonym_layout"
            style="@style/Widget.Prottasha.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:hint="@string/profile_pseudonym_hint">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/profile_pseudonym_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLength="40"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/profile_palette_layout"
            style="@style/Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_compact"
            android:hint="@string/profile_avatar_palette_hint"
            app:boxBackgroundColor="@color/color_surface">
            <AutoCompleteTextView
                android:id="@+id/profile_palette_dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/profile_style_layout"
            style="@style/Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_compact"
            android:hint="@string/profile_avatar_style_hint"
            app:boxBackgroundColor="@color/color_surface">
            <AutoCompleteTextView
                android:id="@+id/profile_style_dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/profile_error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/color_crisis"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/profile_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_medium"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_save_button"
            style="@style/Widget.Prottasha.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/profile_save_action" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
