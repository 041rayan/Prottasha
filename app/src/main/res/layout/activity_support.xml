<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <!-- Header -->
        <TextView
            style="@style/TextAppearance.Prottasha.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/crisis_title" />

        <TextView
            style="@style/TextAppearance.Prottasha.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxsmall"
            android:text="If you are experiencing severe distress or an emergency, immediate verified support is available."
            android:textColor="@color/color_text_secondary" />

        <!-- Directory Status & Refresh Banner -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Prottasha.Surface.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:layout_marginBottom="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/support_status_badge"
                        style="@style/TextAppearance.Prottasha.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/color_hope"
                        android:textStyle="bold"
                        tools:text="VERIFIED DIRECTORY" />

                    <TextView
                        android:id="@+id/support_last_updated"
                        style="@style/TextAppearance.Prottasha.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/color_text_muted"
                        tools:text="Updated 2026-11-10" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/support_refresh_button"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ibm_plex_sans_medium"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="Refresh"
                    android:textColor="@color/color_identity" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Container for Directory Cards -->
        <LinearLayout
            android:id="@+id/support_entries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
