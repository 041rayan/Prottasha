<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingEnd="@dimen/spacing_medium"
        android:paddingTop="@dimen/spacing_small"
        android:paddingBottom="@dimen/spacing_medium">

        <!-- Title -->
        <TextView
            style="@style/TextAppearance.Prottasha.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/circle_title" />

        <TextView
            android:id="@+id/circle_status"
            style="@style/TextAppearance.Prottasha.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxsmall"
            android:textColor="@color/color_text_secondary"
            tools:text="@string/circle_closed_status" />

        <!-- Closed Pod Action Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Prottasha.Surface.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_compact">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_compact">

                <TextView
                    style="@style/TextAppearance.Prottasha.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Closed Peer Pod" />

                <TextView
                    style="@style/TextAppearance.Prottasha.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxsmall"
                    android:textSize="13sp"
                    android:text="Join your closed group of recovery peers. Chat anonymously using your pod pseudonym, see real-time presence, and share support."
                    android:textColor="@color/color_text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/circle_open_pod"
                    style="@style/Widget.Prottasha.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/circle_open" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Personal Accountability Partner Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Prottasha.Surface.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_compact">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_compact">

                <TextView
                    style="@style/TextAppearance.Prottasha.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accountability Partner" />

                <TextView
                    style="@style/TextAppearance.Prottasha.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxsmall"
                    android:textSize="13sp"
                    android:text="Designate a trusted personal ally. Send exact, truthful progress check-ins via your preferred messaging app."
                    android:textColor="@color/color_text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/circle_accountability"
                    style="@style/Widget.Prottasha.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/circle_accountability" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Crisis & Hotlines Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Prottasha.Surface.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_compact">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_compact">

                <TextView
                    style="@style/TextAppearance.Prottasha.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Immediate Crisis Support"
                    android:textColor="@color/color_crisis" />

                <TextView
                    style="@style/TextAppearance.Prottasha.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxsmall"
                    android:textSize="13sp"
                    android:text="Free, 24/7 verified emergency and emotional mental health helplines in Bangladesh (999, Kaan Pete Roi, and more)."
                    android:textColor="@color/color_text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/circle_crisis_help"
                    style="@style/Widget.Prottasha.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="View Support Helplines"
                    android:textColor="@color/color_crisis" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Methodology & Privacy Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Prottasha.Surface.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_compact"
            android:layout_marginBottom="@dimen/spacing_compact">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_compact">

                <TextView
                    style="@style/TextAppearance.Prottasha.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prottasha Circle Privacy" />

                <TextView
                    style="@style/TextAppearance.Prottasha.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxsmall"
                    android:lineSpacingExtra="2dp"
                    android:textSize="13sp"
                    android:text="Closed Pods are provisioned communities designed for mutual accountability without surveillance. Your personal email, recovery journal, usage history, and app rules remain completely private on your phone."
                    android:textColor="@color/color_text_secondary" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
