<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/spacing_large"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="@dimen/spacing_large">

        <TextView
            android:id="@+id/create_account_step"
            style="@style/TextAppearance.Prottasha.Metric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_create_step" />

        <TextView
            android:id="@+id/create_account_title"
            style="@style/TextAppearance.Prottasha.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="@string/auth_create_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/auth_create_explanation"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/auth_error_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:accessibilityLiveRegion="assertive"
            android:background="@color/color_crisis_subtle"
            android:focusable="true"
            android:padding="@dimen/spacing_compact"
            android:textColor="@color/color_crisis"
            android:textSize="@dimen/text_label"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/auth_display_name_layout"
            style="@style/Widget.Prottasha.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:hint="@string/auth_display_name_label">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/auth_display_name_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="name"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="80"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/auth_email_layout"
            style="@style/Widget.Prottasha.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_compact"
            android:hint="@string/auth_email_label">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/auth_email_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="emailAddress"
                android:inputType="textEmailAddress"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/auth_password_layout"
            style="@style/Widget.Prottasha.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_compact"
            android:hint="@string/auth_password_label"
            app:endIconMode="password_toggle">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/auth_password_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="newPassword"
                android:inputType="textPassword"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:columnCount="2"
            android:rowCount="2">
            <TextView android:id="@+id/password_requirement_length" style="@style/TextAppearance.Prottasha.Metric" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:padding="4dp" android:text="@string/auth_requirement_length" />
            <TextView android:id="@+id/password_requirement_uppercase" style="@style/TextAppearance.Prottasha.Metric" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:padding="4dp" android:text="@string/auth_requirement_uppercase" />
            <TextView android:id="@+id/password_requirement_lowercase" style="@style/TextAppearance.Prottasha.Metric" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:padding="4dp" android:text="@string/auth_requirement_lowercase" />
            <TextView android:id="@+id/password_requirement_number" style="@style/TextAppearance.Prottasha.Metric" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:padding="4dp" android:text="@string/auth_requirement_number" />
        </GridLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/auth_confirm_password_layout"
            style="@style/Widget.Prottasha.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:hint="@string/auth_confirm_password_label"
            app:endIconMode="password_toggle">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/auth_confirm_password_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="newPassword"
                android:inputType="textPassword"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/auth_terms_checkbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/auth_accept_terms" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_legal_link"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/auth_read_terms_privacy"
            android:textColor="@color/color_hope" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_create_button"
            style="@style/Widget.Prottasha.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/auth_create_account_action" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
