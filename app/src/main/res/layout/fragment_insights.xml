<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/insights_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_medium"
        android:paddingTop="@dimen/spacing_large"
        android:paddingBottom="@dimen/spacing_xlarge">

        <!-- Title & Range Selector -->
        <TextView
            style="@style/TextAppearance.Prottasha.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/insights_title" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/insights_range_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_today"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_week"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7 Days" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_month"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="30 Days" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Summary & Trend Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Prottasha.Surface.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:id="@+id/insights_summary"
                    style="@style/TextAppearance.Prottasha.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.prottasha.insights.ui.AccessibleTrendView
                    android:id="@+id/insights_trend"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:layout_marginTop="@dimen/spacing_medium" />

                <TextView
                    android:id="@+id/insights_sample"
                    style="@style/TextAppearance.Prottasha.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:textColor="@color/color_text_secondary" />

                <!-- Text Breakdown -->
                <TextView
                    android:id="@+id/insights_text_breakdown"
                    style="@style/TextAppearance.Prottasha.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/color_text_secondary" />

                <!-- Usage overview -->
                <TextView
                    android:id="@+id/insights_usage_overview"
                    style="@style/TextAppearance.Prottasha.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:textColor="@color/color_text_primary" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Patterns Observation Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/insights_patterns_card"
            style="@style/Widget.Prottasha.Surface.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    style="@style/TextAppearance.Prottasha.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Observed Patterns" />

                <TextView
                    android:id="@+id/insights_pattern_text"
                    style="@style/TextAppearance.Prottasha.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:textColor="@color/color_text_secondary" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Target Drill-Down Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Prottasha.Surface.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    style="@style/TextAppearance.Prottasha.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monitored Target Usage" />

                <TextView
                    android:id="@+id/insights_targets_empty"
                    style="@style/TextAppearance.Prottasha.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="No monitored usage in this period."
                    android:textColor="@color/color_text_secondary" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/insights_targets_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Reflections Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Prottasha.Surface.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    style="@style/TextAppearance.Prottasha.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reflections (Fact, Interpretation, Lesson)" />

                <TextView
                    android:id="@+id/insights_reflections_empty"
                    style="@style/TextAppearance.Prottasha.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="No reflections written yet."
                    android:textColor="@color/color_text_secondary" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/insights_reflections_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:nestedScrollingEnabled="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/insights_reflect"
                    style="@style/Widget.Prottasha.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/insights_reflect" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Trigger & Rebound Plans Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Prottasha.Surface.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    style="@style/TextAppearance.Prottasha.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trigger &amp; Rebound Plans" />

                <TextView
                    style="@style/TextAppearance.Prottasha.Metric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Implementation intentions: If [Cue] → Then [Plan]"
                    android:textColor="@color/color_text_secondary" />

                <TextView
                    android:id="@+id/insights_triggers_empty"
                    style="@style/TextAppearance.Prottasha.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="No trigger plans configured yet."
                    android:textColor="@color/color_text_secondary" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/insights_triggers_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:nestedScrollingEnabled="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/insights_add_trigger"
                    style="@style/Widget.Prottasha.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="Add Trigger Plan" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Success Memory Bank Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Prottasha.Surface.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    style="@style/TextAppearance.Prottasha.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Success Memory Bank" />

                <TextView
                    style="@style/TextAppearance.Prottasha.Metric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Anchor real past moments of calm and self-control."
                    android:textColor="@color/color_text_secondary" />

                <TextView
                    android:id="@+id/insights_memories_empty"
                    style="@style/TextAppearance.Prottasha.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="No success memories stored yet."
                    android:textColor="@color/color_text_secondary" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/insights_memories_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:nestedScrollingEnabled="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/insights_add_memory"
                    style="@style/Widget.Prottasha.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="Add Success Memory" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Rehearsal Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Prottasha.Surface.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    style="@style/TextAppearance.Prottasha.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mental Rehearsal" />

                <TextView
                    android:id="@+id/insights_rehearsal_status"
                    style="@style/TextAppearance.Prottasha.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="Rehearse handling high-friction moments with calm course-correction."
                    android:textColor="@color/color_text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/insights_rehearsal"
                    style="@style/Widget.Prottasha.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="Start Mental Rehearsal" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Methodology Link -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/insights_methodology"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/insights_methodology" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
