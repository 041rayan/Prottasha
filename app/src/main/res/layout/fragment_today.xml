<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/today_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/spacing_medium"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="@dimen/spacing_xlarge">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="@dimen/spacing_medium">

                <TextView
                    android:id="@+id/today_date"
                    style="@style/TextAppearance.Prottasha.Metric"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/today_date_placeholder"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/today_greeting"
                    style="@style/TextAppearance.Prottasha.Headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xsmall"
                    android:breakStrategy="balanced"
                    android:maxLines="3" />
            </LinearLayout>

            <TextView
                android:id="@+id/today_avatar"
                style="@style/TextAppearance.Prottasha.Label"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="@drawable/shape_avatar_circle"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:textColor="@color/color_hope" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/today_health_banner"
            style="@style/Widget.Prottasha.Surface.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:id="@+id/today_health_title"
                    style="@style/TextAppearance.Prottasha.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/today_health_title" />

                <TextView
                    android:id="@+id/today_health_body"
                    style="@style/TextAppearance.Prottasha.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xsmall"
                    android:text="@string/today_health_body"
                    android:textColor="@color/color_text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/today_health_action"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/today_health_action" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/today_identity_card"
            style="@style/Widget.Prottasha.Surface.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/hero_corner_radius">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="true"
                android:clipToPadding="true">

                <View
                    android:layout_width="240dp"
                    android:layout_height="96dp"
                    android:layout_gravity="end|bottom"
                    android:background="@drawable/bg_identity_horizon_arc"
                    android:importantForAccessibility="no"
                    android:translationX="52dp"
                    android:translationY="52dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        style="@style/TextAppearance.Prottasha.Metric"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/today_identity_label"
                        android:textAllCaps="true"
                        android:textColor="@color/color_identity" />

                    <TextView
                        android:id="@+id/today_identity_statement"
                        style="@style/TextAppearance.Prottasha.Headline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:breakStrategy="balanced"
                        android:maxLines="6" />

                    <TextView
                        android:id="@+id/today_identity_purpose"
                        style="@style/TextAppearance.Prottasha.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:textColor="@color/color_text_secondary"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/today_success_memory"
                        style="@style/TextAppearance.Prottasha.Metric"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:maxLines="4"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/today_empty_title"
            style="@style/TextAppearance.Prottasha.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/today_empty_title" />

        <TextView
            android:id="@+id/today_empty_body"
            style="@style/TextAppearance.Prottasha.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/today_empty_body"
            android:textColor="@color/color_text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/today_hope_horizon_card"
                style="@style/Widget.Prottasha.Surface.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <TextView
                        android:id="@+id/today_hope_horizon_title"
                        style="@style/TextAppearance.Prottasha.Metric"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/today_hope_horizon_title"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/today_hope_horizon_empty"
                        style="@style/TextAppearance.Prottasha.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="@string/today_hope_horizon_empty"
                        android:textColor="@color/color_text_secondary" />

                    <LinearLayout
                        android:id="@+id/today_hope_horizon_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/today_hope_horizon_summary"
                            style="@style/TextAppearance.Prottasha.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/today_hope_horizon_details"
                            style="@style/TextAppearance.Prottasha.Metric"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xsmall"
                            android:maxLines="3" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="@dimen/spacing_compact"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/today_focus_button"
                style="@style/Widget.Prottasha.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:minHeight="112dp"
                android:text="@string/today_focus_action" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xlarge"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.Prottasha.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/today_consistency_title" />

            <TextView
                style="@style/TextAppearance.Prottasha.Metric"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/today_consistency_range"
                android:textAllCaps="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="18dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingEnd="@dimen/spacing_xsmall">

                <TextView
                    style="@style/TextAppearance.Prottasha.Metric"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="@string/today_monday_short" />
                <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
                <TextView
                    style="@style/TextAppearance.Prottasha.Metric"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="@string/today_wednesday_short" />
                <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
                <TextView
                    style="@style/TextAppearance.Prottasha.Metric"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="@string/today_friday_short" />
                <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
                <TextView
                    style="@style/TextAppearance.Prottasha.Metric"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="@string/today_sunday_short" />
            </LinearLayout>

            <com.prottasha.habits.ui.HabitConsistencyHeatmapView
                android:id="@+id/today_consistency_heatmap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.Prottasha.Metric"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/today_consistency_quiet" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="10dp" android:layout_height="10dp"
                android:layout_marginStart="@dimen/spacing_small"
                app:cardBackgroundColor="@color/color_surface_raised" app:cardCornerRadius="3dp" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="10dp" android:layout_height="10dp"
                android:layout_marginStart="@dimen/spacing_xsmall"
                app:cardBackgroundColor="@color/color_consistency_level_1" app:cardCornerRadius="3dp" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="10dp" android:layout_height="10dp"
                android:layout_marginStart="@dimen/spacing_xsmall"
                app:cardBackgroundColor="@color/color_consistency_level_2" app:cardCornerRadius="3dp" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="10dp" android:layout_height="10dp"
                android:layout_marginStart="@dimen/spacing_xsmall"
                app:cardBackgroundColor="@color/color_consistency_level_3" app:cardCornerRadius="3dp" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="10dp" android:layout_height="10dp"
                android:layout_marginStart="@dimen/spacing_xsmall"
                app:cardBackgroundColor="@color/color_consistency_level_4" app:cardCornerRadius="3dp" />

            <TextView
                style="@style/TextAppearance.Prottasha.Metric"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:text="@string/today_consistency_strong" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/today_consistency_active_days"
                    style="@style/TextAppearance.Prottasha.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/today_metric_zero" />
                <TextView
                    style="@style/TextAppearance.Prottasha.Metric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/today_active_days_label" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/today_consistency_best_run"
                    style="@style/TextAppearance.Prottasha.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/today_metric_zero" />
                <TextView
                    style="@style/TextAppearance.Prottasha.Metric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/today_best_run_label" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/today_consistency_percent"
                    style="@style/TextAppearance.Prottasha.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/today_metric_percent_zero" />
                <TextView
                    style="@style/TextAppearance.Prottasha.Metric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/today_consistency_label" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/today_consistency_empty"
            style="@style/TextAppearance.Prottasha.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/today_consistency_no_data"
            android:textColor="@color/color_text_secondary" />

        <TextView
            android:id="@+id/today_habits_title"
            style="@style/TextAppearance.Prottasha.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xlarge"
            android:text="@string/today_habits_title" />

        <TextView
            android:id="@+id/today_habits_empty"
            style="@style/TextAppearance.Prottasha.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/today_habits_empty"
            android:textColor="@color/color_text_secondary" />

        <LinearLayout
            android:id="@+id/today_habits_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:divider="@drawable/divider_subtle"
            android:orientation="vertical"
            android:showDividers="middle" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/spacing_xlarge"
            android:background="@color/color_border_subtle" />

        <TextView
            android:id="@+id/today_boundaries_title"
            style="@style/TextAppearance.Prottasha.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/today_boundaries_title" />

        <TextView
            android:id="@+id/today_boundaries_empty"
            style="@style/TextAppearance.Prottasha.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/today_boundaries_empty"
            android:textColor="@color/color_text_secondary" />

        <TextView
            android:id="@+id/today_boundaries_count"
            style="@style/TextAppearance.Prottasha.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:visibility="gone" />

        <TextView
            android:id="@+id/today_boundaries_list"
            style="@style/TextAppearance.Prottasha.Metric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:maxLines="4"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
