<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Prottasha.Surface.Tonal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_small">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <TextView
            android:id="@+id/reflection_date"
            style="@style/TextAppearance.Prottasha.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_hope"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reflection_fact_display"
            style="@style/TextAppearance.Prottasha.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/color_text_primary" />

        <TextView
            android:id="@+id/reflection_interpretation_display"
            style="@style/TextAppearance.Prottasha.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/color_text_secondary" />

        <TextView
            android:id="@+id/reflection_lesson_display"
            style="@style/TextAppearance.Prottasha.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/color_identity"
            android:textStyle="italic" />

        <ImageView
            android:id="@+id/reflection_thumb"
            android:layout_width="80dp"
            android:layout_height="60dp"
            android:layout_marginTop="@dimen/spacing_small"
            android:scaleType="centerCrop"
            android:contentDescription="Attached reflection image thumbnail"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
