<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_pause_scrim"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large">

        <TextView
            android:id="@+id/intervention_title"
            style="@style/TextAppearance.Prottasha.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/intervention_title" />

        <TextView
            android:id="@+id/intervention_target"
            style="@style/TextAppearance.Prottasha.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxsmall"
            android:gravity="center"
            android:textColor="@color/color_text_secondary" />

        <!-- Countdown / Breathing Banner -->
        <TextView
            android:id="@+id/intervention_countdown_text"
            style="@style/TextAppearance.Prottasha.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:gravity="center"
            android:textColor="@color/color_friction"
            android:visibility="gone" />

        <!-- Intention Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/intervention_intention_layout"
            style="@style/Widget.Prottasha.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:hint="@string/intervention_intention_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/intervention_intention"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Immediate Step Back -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/intervention_step_back"
            style="@style/Widget.Prottasha.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/intervention_step_back" />

        <!-- Healthy Replacement Habit -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/intervention_replacement_button"
            style="@style/Widget.Prottasha.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:minHeight="@dimen/touch_target_min"
            android:visibility="gone" />

        <!-- Start Focus Session -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/intervention_focus_button"
            style="@style/Widget.Prottasha.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:minHeight="@dimen/touch_target_min"
            android:text="Start 25-Min Focus Session" />

        <!-- Continue Intentional Action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/intervention_continue"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:fontFamily="@font/ibm_plex_sans_medium"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/intervention_continue"
            android:textColor="@color/color_text_secondary" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
