<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Prottasha.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_semibold</item>
        <item name="fontFamily">@font/ibm_plex_sans_semibold</item>
        <item name="android:textColor">@color/color_on_hope</item>
        <item name="backgroundTint">@color/color_hope</item>
        <item name="cornerRadius">@dimen/control_corner_radius</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Prottasha.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_medium</item>
        <item name="fontFamily">@font/ibm_plex_sans_medium</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="strokeColor">@color/color_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/control_corner_radius</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Prottasha.Button.Icon" parent="Widget.Material3.Button.TextButton">
        <item name="android:minWidth">@dimen/touch_target_min</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">@color/color_text_secondary</item>
        <item name="cornerRadius">@dimen/control_corner_radius</item>
        <item name="backgroundTint">@color/color_surface</item>
        <item name="rippleColor">@color/color_ripple_light</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Prottasha.Surface.Tonal" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/color_surface_raised</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">@color/color_ripple_light</item>
    </style>

    <style name="Widget.Prottasha.Row" parent="">
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">@dimen/spacing_compact</item>
        <item name="android:paddingBottom">@dimen/spacing_compact</item>
        <item name="android:background">@drawable/bg_row_selector</item>
    </style>

    <style name="Widget.Prottasha.Segmented" parent="Widget.Material3.Chip.Filter">
        <item name="android:minHeight">40dp</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_medium</item>
        <item name="fontFamily">@font/ibm_plex_sans_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="chipCornerRadius">@dimen/chip_radius</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipBackgroundColor">@color/color_surface</item>
    </style>
</resources>
