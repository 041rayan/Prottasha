<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme: Obsidian & Biophilic Calm -->
    <style name="Theme.Prottasha" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/color_bg_primary</item>
        <item name="android:colorBackground">@color/color_bg_primary</item>
        <item name="colorSurface">@color/color_surface_card</item>
        <item name="colorPrimary">@color/color_identity_glow</item>
        <item name="colorOnPrimary">@color/color_text_inverse</item>
        <item name="colorSecondary">@color/color_vote_emerald</item>
        <item name="colorOnSecondary">@color/color_text_inverse</item>
        <item name="android:textColorPrimary">@color/color_text_primary</item>
        <item name="android:textColorSecondary">@color/color_text_secondary</item>
        <item name="android:navigationBarColor">@color/color_bg_primary</item>
        <item name="android:statusBarColor">@color/color_bg_primary</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.Prottasha.Splash" parent="Theme.Prottasha">
        <item name="android:windowBackground">@color/color_bg_primary</item>
    </style>

    <!-- Pause Interstitial Overlay Theme (Over other apps) -->
    <style name="Theme.Prottasha.PauseOverlay" parent="Theme.Prottasha">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">#E60B0F17</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

    <!-- Card and Surface Styles -->
    <style name="Widget.Prottasha.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/color_surface_card</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeColor">@color/color_border_subtle</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Pill Button Styles -->
    <style name="Widget.Prottasha.Button.Pill" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="cornerRadius">@dimen/pill_button_radius</item>
        <item name="backgroundTint">@color/color_identity_glow</item>
    </style>
</resources>
