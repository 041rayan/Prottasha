<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme: Quiet Precision. -->
    <style name="Theme.Prottasha" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/color_background</item>
        <item name="android:colorBackground">@color/color_background</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorSurfaceVariant">@color/color_surface_raised</item>
        <item name="colorPrimary">@color/color_hope</item>
        <item name="colorOnPrimary">@color/color_on_hope</item>
        <item name="colorSecondary">@color/color_identity</item>
        <item name="colorOnSecondary">@color/color_on_identity</item>
        <item name="colorError">@color/color_crisis</item>
        <item name="colorOnError">@color/color_on_crisis</item>
        <item name="android:textColorPrimary">@color/color_text_primary</item>
        <item name="android:textColorSecondary">@color/color_text_secondary</item>
        <item name="android:navigationBarColor">@color/color_background</item>
        <item name="android:statusBarColor">@color/color_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_regular</item>
        <item name="fontFamily">@font/ibm_plex_sans_regular</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.Prottasha.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/color_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Prottasha</item>
    </style>

    <!-- Pause Interstitial Overlay Theme (Over other apps) -->
    <style name="Theme.Prottasha.PauseOverlay" parent="Theme.Prottasha">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@color/color_pause_scrim</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

    <!-- Card and Surface Styles -->
    <style name="Widget.Prottasha.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/color_surface_card</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeColor">@color/color_border_subtle</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Pill Button Styles -->
    <style name="Widget.Prottasha.Button.Pill" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/color_on_hope</item>
        <item name="cornerRadius">@dimen/pill_button_radius</item>
        <item name="backgroundTint">@color/color_hope</item>
    </style>

    <style name="TextAppearance.Prottasha.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/newsreader_semibold</item>
        <item name="fontFamily">@font/newsreader_semibold</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.Prottasha.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/newsreader_medium</item>
        <item name="fontFamily">@font/newsreader_medium</item>
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.Prottasha.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/ibm_plex_sans_semibold</item>
        <item name="fontFamily">@font/ibm_plex_sans_semibold</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.Prottasha.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/ibm_plex_sans_regular</item>
        <item name="fontFamily">@font/ibm_plex_sans_regular</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.Prottasha.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/ibm_plex_sans_medium</item>
        <item name="fontFamily">@font/ibm_plex_sans_medium</item>
        <item name="android:textSize">@dimen/text_label</item>
    </style>

    <style name="TextAppearance.Prottasha.Metric" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/ibm_plex_mono_medium</item>
        <item name="fontFamily">@font/ibm_plex_mono_medium</item>
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>
</resources>
