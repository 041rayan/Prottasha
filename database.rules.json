{
  "rules": {
    ".read": false,
    ".write": false,
    "podMembers": {
      "$podId": {
        "$uid": {
          ".read": "auth != null && root.child('podMembers').child($podId).child(auth.uid).val() == true",
          ".write": "auth != null && auth.uid == $uid && data.val() == true && !newData.exists()",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "presence": {
      "$podId": {
        ".read": "auth != null && root.child('podMembers').child($podId).child(auth.uid).val() == true",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid && root.child('podMembers').child($podId).child(auth.uid).val() == true",
          ".validate": "newData.hasChildren(['online', 'lastChanged'])",
          "online": { ".validate": "newData.isBoolean()" },
          "lastChanged": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "typing": {
      "$podId": {
        ".read": "auth != null && root.child('podMembers').child($podId).child(auth.uid).val() == true",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid && root.child('podMembers').child($podId).child(auth.uid).val() == true",
          ".validate": "newData.hasChildren(['typing', 'lastChanged'])",
          "typing": { ".validate": "newData.isBoolean()" },
          "lastChanged": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
